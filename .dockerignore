# Context for build/Dockerfile: pyproject.toml, uv.lock, README.md, src/, tests/.
# tests/e2e/Dockerfile has its own tests/e2e/Dockerfile.dockerignore, which
# lets dist/ in; dist/ stays out of this context.

# VCS and editor/tooling
.git
.github
.idea
.vscode
.claude
**/.local
**/.scratch

# Host Python environment and caches
.venv
**/__pycache__
**/*.pyc
.pytest_cache
.ruff_cache
**/*.egg-info

# Build output
**/.bin
dist

# Not needed inside the image
build
deploy
scripts
docs

# OS junk
**/.DS_Store
**/._*
**/*~
