{
  "permissions": {
    "allow": [
      "Bash(docker *)",
      "Bash(./build/build.sh)",
      "Bash(./build/build.sh *)"
    ]
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "enabled": true,
    "excludedCommands": [
      "docker *",
      "./build/build.sh",
      "./build/build.sh *"
    ],
    "failIfUnavailable": true,
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/.netrc",
        "~/.claude"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "crates.io",
        "*.crates.io",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "storage.googleapis.com"
      ]
    }
  }
}
